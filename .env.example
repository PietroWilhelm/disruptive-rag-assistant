# Chave da Gemini API (grátis): https://aistudio.google.com/apikey  — NUNCA suba o .env para o GitHub
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelos usados nos Labs 3 e 4 (opcional: estes já são os padrões)
# GEMINI_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=gemini-embedding-2

# De onde vem o material da disciplina (opcional)
# MATERIAL_REPO=PietroWilhelm/DisruptiveArchitectures
# MATERIAL_BRANCH=master
# MATERIAL_DIR=/caminho/do/clone/DisruptiveArchitectures/material   # se já tiver clonado, evita o download

# Quais arquivos indexar (opcional). Útil na camada gratuita: 1.000 embeddings por dia
# MATERIAL_INCLUIR=aulas/genAI,aulas/checkpoint,agenda
# MATERIAL_EXCLUIR=*copy.*,*cp-correcao*
# EMBEDDING_RPM=80             # máx. de embeddings por minuto (gratuito: 100). 0 desliga o controle

# Busca (opcional)
# TOP_K=4
# SIMILARIDADE_MINIMA=0.40     # calibre com: python -m scripts.avaliar_recuperacao

# Operação / deploy (opcional)
# DATABASE_PATH=data/rag.db    # no Railway: /data/rag.db (com um Volume montado em /data)
# AUTO_INGESTAO=true           # indexa sozinho na primeira subida, se o banco estiver vazio
# LIMITE_MENSAGENS_POR_MINUTO=20
